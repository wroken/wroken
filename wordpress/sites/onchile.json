{
  "id": "onchile",
  "name": "OnChile",
  "url": "https://onchile.com",
  "enabled": true,
  "language": "es-CL",
  "niche": "REVISAR (supuesto): actualidad, cultura y panoramas en Chile",
  "audience": "Público chileno y extranjeros interesados en Chile",
  "tone": "cercano, claro y bien documentado; tuteo; sin exageraciones",
  "guidelines": [
    "No inventar datos, cifras ni citas: todo dato verificable debe venir de una fuente enlazada"
  ],
  "frequency": {
    "everyHours": 24,
    "maxPostsPerRun": 1
  },
  "publishing": {
    "status": "publish",
    "minQualityScore": 7,
    "author": null,
    "defaultCategory": "Actualidad",
    "allowNewCategories": false,
    "hours": [
      7,
      22
    ],
    "timezone": "America/Santiago"
  },
  "content": {
    "minWords": 900,
    "maxWords": 1600,
    "minSources": 3,
    "includeFaq": true,
    "includeSourcesSection": true,
    "internalLinks": 3
  },
  "categories": [
    "Actualidad"
  ],
  "topics": {
    "pillars": [
      "Actualidad de Chile",
      "Cultura y panoramas",
      "Turismo en Chile"
    ],
    "seedTopics": [],
    "avoid": []
  },
  "sources": {
    "preferred": [
      "gob.cl",
      "ine.gob.cl",
      "bcn.cl"
    ],
    "blocked": []
  },
  "images": {
    "featured": [
      "internet",
      "magnific",
      "higgsfield"
    ],
    "inContent": 1,
    "style": "fotografía editorial realista, luz natural, sin texto ni logos",
    "aspectRatio": "16:9",
    "internetProviders": [
      "openverse",
      "wikimedia",
      "pexels"
    ]
  },
  "seo": {
    "plugin": "auto",
    "minContentScore": 70
  },
  "refresh": {
    "enabled": true,
    "olderThanDays": 270,
    "everyHours": 168
  },
  "notify": {
    "email": null,
    "onPublish": false,
    "onDraft": true,
    "onFail": true
  },
  "searchConsole": {
    "property": "sc-domain:onchile.com"
  }
}
